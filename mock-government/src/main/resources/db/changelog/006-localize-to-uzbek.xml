    <changeSet id="6-localize-rules-uzbek" author="system">
        <update tableName="transfer_rules">
            <column name="title" value="Ichki ko'chirish"/>
            <column name="description" value="O'zbekiston oliy ta'lim muassasalari o'rtasida o'qishni ko'chirish"/>
            <column name="application_period" value="15-iyuldan 5-avgustgacha"/>
            <where>title = 'Domestic Transfer'</where>
        </update>
        <update tableName="transfer_rules">
            <column name="title" value="Xorijdan ko'chirish"/>
            <column name="description" value="Xorijiy oliy ta'lim muassasalaridan o'qishni ko'chirish"/>
            <column name="application_period" value="15-iyuldan 5-avgustgacha"/>
            <where>title = 'International Transfer'</where>
        </update>

        <update tableName="academic_leave_rules">
            <column name="title" value="Tibbiy ta'til"/>
            <column name="description" value="Salomatlik holati yuzasidan beriladigan akademik ta'til"/>
            <where>title = 'Medical Leave'</where>
        </update>
        <update tableName="academic_leave_rules">
            <column name="title" value="Harbiy xizmat"/>
            <column name="description" value="Muddatli harbiy xizmatni o'tash uchun beriladigan akademik ta'til"/>
            <where>title = 'Military Service'</where>
        </update>
    </changeSet>

</databaseChangeLog>
