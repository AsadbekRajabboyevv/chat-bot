            <column name="faculty" value="Kompyuter ilmlari"/>
            <where>student_id_number = 'STU-001'</where>
        </update>
        <update tableName="students">
            <column name="university_name" value="O'zbekiston Milliy universiteti"/>
            <column name="faculty" value="Matematika"/>
            <where>student_id_number = 'STU-002'</where>
        </update>
